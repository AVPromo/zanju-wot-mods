# Local machine settings for repo tooling.
# Copy this file to .env and fill in the paths for your machine.

# Optional for build-only CI; required for deploy, cleanup, and cycle commands.
# When provided, tooling validates version.xml against tools/wot_version_manifest.json.
WOT_GAME_DIR=

# Python 2.7 executable used to compile src/*.py -> .pyc during build.
WOT_PYTHON2_EXE=
