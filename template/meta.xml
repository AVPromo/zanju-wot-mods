<?xml version="1.0" encoding="utf-8"?>
<root>
    <!-- Unique reverse-domain mod identifier. Change before release. -->
    <id>com.yourname.modname</id>

    <!-- Display name shown in ModsList / launcher -->
    <name>Your Mod Name</name>

    <!-- Semantic version: MAJOR.MINOR.PATCH.BUILD -->
    <version>0.1.0.0</version>

    <!-- Short human-readable description -->
    <description>One-line description of what this mod does.</description>

    <!-- WoT client version this was built against (update each patch) -->
    <wot_client_version>2.2.1.1</wot_client_version>

    <!--
        Optional tags (comma-separated):
        ui, battle, hangar, statistics, minimap, markers, equipment
    -->
    <tags></tags>

    <!-- Author contact (optional) -->
    <author>yourname</author>
    <url></url>
</root>
